  "f": "en-a1-u01-14.mp3"
 },
 {
  "role": "en_lucas",
  "text": "I'm from Brazil.",
  "lang": "en",
  "f": "en-a1-u01-15.mp3"
 },
 {
  "role": "pt_narrador",
  "text": "Em português, podemos omitir o sujeito. Nessa frase em inglês, ele precisa aparecer.",
  "lang": "pt",
  "f": "en-a1-u01-16.mp3"
 },
 {
  "role": "en_lucas",
  "text": "I'm from Brazil.",
  "lang": "en",
  "f": "en-a1-u01-17.mp3"
 },
 {
  "role": "pt_narrador",
  "text": "Qual opção completa a frase corretamente?",
