 },
 {
  "role": "en_sarah",
  "text": "Hi, I'm Sarah.",
  "lang": "en",
  "f": "en-a1-u01-12.mp3"
 },
 {
  "role": "en_lucas",
  "text": "Hi, I'm Lucas.",
  "lang": "en",
  "f": "en-a1-u01-13.mp3"
 },
 {
  "role": "en_sarah",
  "text": "I'm from Canada.",
