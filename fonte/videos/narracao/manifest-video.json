 },
 {
  "role": "en_vendedor",
  "text": "I'm from Japan.",
  "lang": "en",
  "f": "en-a1-u01-19.mp3"
 },
 {
  "role": "pt_narrador",
  "text": "O sujeito e o verbo estão juntos, formando uma contração.",
  "lang": "pt",
  "f": "en-a1-u01-20.mp3"
 },
 {
  "role": "pt_narrador",
  "text": "Agora precisamos indicar a origem. Qual palavra encaixa?",
  "lang": "pt",
  "f": "en-a1-u01-21.mp3"
 },
 {
  "role": "en_lucas",
  "text": "I'm from Brazil.",
