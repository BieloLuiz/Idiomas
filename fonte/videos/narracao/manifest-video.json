  "f": "fr-a1-u01-21.mp3"
 },
 {
  "role": "fr_lucas",
  "text": "Je viens du Brésil.",
  "lang": "fr",
  "f": "fr-a1-u01-22.mp3"
 },
 {
  "role": "pt_narrador",
  "text": "Nesse caso, a preposição e o artigo masculino se contraem.",
